# CONFIGURACIÓN PARA DESPLIEGUE (HOSTING Y DNS)
# Copia este archivo a .env y rellena los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
#
# Alternativas de Hosting pertinentes propuestas para producción: PythonAnywhere o Render.
# El dominio en producción será traducido a la IP del servidor mediante el sistema DNS.

# Clave de firma de Django (sesiones y CSRF). NO es una API key de un servicio externo.
SECRET_KEY=cambia-esta-clave-antes-de-usar-en-produccion
DEBUG=True

ALLOWED_HOSTS=127.0.0.1, localhost, .pythonanywhere.com, .render.com

# Base de datos. En local se usa SQLite (valores por defecto).
# En producción: DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0
